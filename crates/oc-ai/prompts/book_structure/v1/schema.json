{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["frontmatter_end_idx", "part_boundaries", "backmatter_start_idx"],
  "properties": {
    "frontmatter_end_idx": { "$ref": "#/$defs/index" },
    "part_boundaries": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/index" }
    },
    "backmatter_start_idx": { "$ref": "#/$defs/index" }
  },
  "$defs": {
    "index": { "type": "integer", "minimum": 0, "maximum": 9999 }
  }
}
