{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenConvert",
  "version": "1.0.0",
  "identifier": "io.github.egeselbzgyk.OpenConvert",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenConvert",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-src ocpreview: http://ocpreview.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "publisher": "OpenConvert contributors",
    "copyright": "Copyright OpenConvert contributors. Licensed under the Apache License, Version 2.0.",
    "category": "Productivity",
    "shortDescription": "Convert PDF books to reflowable EPUB, on this computer",
    "longDescription": "OpenConvert turns a PDF into a reflowable EPUB 3.3 on your own computer. Nothing is uploaded, there is no telemetry, and the optional AI assistance runs a local model you choose to download.",
    "externalBin": [
      "bin/openconvert-engine",
      "bin/llama-server"
    ],
    "resources": {
      "../../../models.toml": "models.toml",
      "../../../thresholds.toml": "thresholds.toml",
      "bin/licenses/": "licenses/",
      "../../../NOTICE": "NOTICE",
      "../../../licenses/third-party-rust.txt": "licenses/third-party-rust.txt"
    },
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QzY5Q0ExMjJDMTFCMApSV1N3RVN3U3ltbHNERkhyak5LRnlSdU1xdXJucXVuTEErak9mRU9BQWVWVXlGVSttbEtjZktUZwo=",
      "endpoints": [
        "https://github.com/egeselbzgyk/openconvert/releases/latest/download/latest.json"
      ]
    }
  }
}
