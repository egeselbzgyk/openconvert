/target
/.loop/log-*
/apps/desktop/node_modules
/apps/desktop/src-tauri/target
/apps/desktop/src-tauri/bin/
/corpus/downloads/
/corpus/cache/
/eval/.venv
/vendor/pdfium/
# Fetched by `xtask fetch-epubcheck` and `xtask fetch-epubcheck-corpus`. Never committed:
# EPUBCheck is 33 MB and its test corpus is several thousand files of other people's fixtures.
/vendor/epubcheck/
/vendor/llama-server
/vendor/epubcheck-corpus/
/vendor/.epubcheck-corpus-staging/
__pycache__/
*.pyc
.DS_Store
/apps/desktop/ui/dist
/apps/desktop/ui/node_modules
/example_pdfs
# Playwright's own output. The specs and the config are committed; the browser download, the
# installed modules and the per-run results are not. `target/dom` is under /target already.
/tests/dom/node_modules
/tests/dom/test-results
/tests/dom/results
/tests/dom/playwright-report
/corpus/LOCAL_EVAL_ONLY/
/eval/out/*.png
/corpus/reading/accepted_*.json
